{
  "name": "pawlaris",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, zero-cost pet care for one family. See spec/ before writing code.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:list": "node scripts/verify.mjs --list",
    "lint": "node scripts/verify.mjs --group lint",
    "typecheck": "node scripts/verify.mjs --group typecheck",
    "test": "node scripts/verify.mjs --group test",
    "vectors": "node scripts/verify.mjs --only vectors",
    "contract-check": "node scripts/verify.mjs --only contract-check",
    "contract-freeze": "node scripts/contract-check.mjs --freeze",
    "types": "pnpm -C packages/shared run types",
    "security": "node scripts/verify.mjs --only security"
  },
  "packageManager": "pnpm@12.4.1"
}
