# Copy to .env.reserve on the owner's computer and fill every placeholder.
DATABASE_URL=postgresql+asyncpg://reserve_user:REPLACE_WITH_RESERVE_DATABASE_PASSWORD@127.0.0.1:5432/pawlaris_reserve
JWT_SECRET=REPLACE_WITH_A_RANDOM_RESERVE_SECRET_AT_LEAST_32_BYTES

BLOB_DIR=C:\Users\<owner>\Pawlaris reserve blobs
PUSH_ENABLED=true
SERVER_ROLE=reserve
APP_VERSION=dev
LOG_LEVEL=INFO
WS_AUTH_TIMEOUT_SECONDS=5
WS_SWEEP_SECONDS=30
